# Copy to .env and fill in. Never commit .env.

# ---- Core ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/sceneos
REDIS_URL=redis://localhost:6379
# 32+ random characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# The address people open in the browser (no trailing slash). On the server: https://<DOMAIN>
WEB_ORIGIN=http://localhost:3000
# Server only: the domain Caddy serves over HTTPS, without https://
DOMAIN=
# Where Next forwards /api in development
API_URL=http://localhost:4000

# ---- First admin (used by `pnpm seed`) ----
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- AI (optional until you wire it) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Storyboard images and motion clips. Paste the key as "<key id>:<key secret>".
HIGGSFIELD_API_KEY=
# Optional: change the models or clip length (3 to 15 seconds)
# HIGGSFIELD_IMAGE_MODEL=higgsfield-ai/soul/v2/standard
# HIGGSFIELD_EDIT_MODEL=alibaba/qwen-image-3/edit
# HIGGSFIELD_VIDEO_MODEL=kling-video/v3.0-turbo/image-to-video
# HIGGSFIELD_VIDEO_SECONDS=5

# Teaser voice-over and music (elevenlabs.io). Without it teasers are made without sound.
ELEVENLABS_API_KEY=

# ---- DigitalOcean Spaces (document vault) ----
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# ---- Production health levels (placeholders, confirm with the business) ----
HEALTH_BUDGET_AMBER_PCT=75
HEALTH_BUDGET_RED_PCT=90
HEALTH_PENDING_AMBER=2
HEALTH_PENDING_RED=5
