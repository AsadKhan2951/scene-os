# Copy to .env and fill in. Never commit .env.

# ---- Core ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/sceneos
REDIS_URL=redis://localhost:6379
# 32+ random characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# The address people open in the browser (no trailing slash). On the server: https://<DOMAIN>
WEB_ORIGIN=http://localhost:3000
# Server only: the domain Caddy serves over HTTPS, without https://
DOMAIN=
# Where Next forwards /api in development
API_URL=http://localhost:4000

# ---- First admin (used by `pnpm seed`) ----
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- AI (optional until you wire it) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Storyboard images. The Higgsfield request shape in apps/api/src/lib/images.ts must be confirmed first.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_URL=

# ---- DigitalOcean Spaces (document vault) ----
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# ---- Production health levels (placeholders, confirm with the business) ----
HEALTH_BUDGET_AMBER_PCT=75
HEALTH_BUDGET_RED_PCT=90
HEALTH_PENDING_AMBER=2
HEALTH_PENDING_RED=5
